@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT @HA_BUILD_SHARED@)
  if(@HA_BACKEND_ALSA@ OR @HA_BACKEND_PIPEWIRE@)
    find_dependency(Threads)
    find_dependency(PkgConfig)
  endif()
  if(@HA_BACKEND_ALSA@)
    pkg_check_modules(ALSA REQUIRED IMPORTED_TARGET alsa)
  endif()
  if(@HA_BACKEND_PIPEWIRE@)
    pkg_check_modules(PIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3>=0.3.65)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/HailTargets.cmake")
check_required_components(Hail)
